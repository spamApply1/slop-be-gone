{
  "description": "Self-policing rules for the SBG repository itself",
  "rules": [
    {
      "id": "self-placeholder-comments",
      "type": "placeholder-comments",
      "enabled": true,
      "patterns": [
        "placeholder",
        "put your code here",
        "replace me",
        "change me",
        "sample content"
      ]
    },
    {
      "id": "self-marker-spam",
      "type": "marker-spam",
      "enabled": true,
      "patterns": ["TODO", "FIXME", "XXX"],
      "threshold": 5
    },
    {
      "id": "self-empty-files",
      "type": "empty-files",
      "enabled": true
    },
    {
      "id": "self-long-lines",
      "type": "long-lines",
      "enabled": true,
      "max_length": 120
    },
    {
      "id": "self-file-size",
      "type": "file-size",
      "enabled": true,
      "max_bytes": 1048576
    }
  ]
}
